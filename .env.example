# .env.example - Copia este archivo como .env.local y completa valores reales
# NUNCA subas .env.local ni .env.production a GitHub
# No uses placeholders con forma de JWT, PAT ni connection strings reales.

# ================================
# SUPABASE - APP NEXT/VERCEL
# ================================
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=replace-with-random-cron-secret

# ================================
# SUPABASE - CLI/SCRIPTS
# ================================
SUPABASE_PROJECT_REF=replace-with-project-ref
SUPABASE_ACCESS_TOKEN=replace-with-supabase-access-token
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
DATABASE_URL=replace-with-postgres-connection-string

# ================================
# AI / LLM APIs
# ================================
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ================================
# MARKET DATA APIs
# ================================
ALPHA_VANTAGE_API_KEY=replace-with-alpha-vantage-api-key
FINNHUB_API_KEY=replace-with-finnhub-api-key
MARKETAUX_API_KEY=replace-with-marketaux-api-key
NEWSAPI_KEY=replace-with-newsapi-key
POLYGON_API_KEY=replace-with-polygon-api-key

# ================================
# ALPACA CONNECT - OAUTH / PAPER
# ================================
ALPACA_CLIENT_ID=replace-with-alpaca-connect-client-id
ALPACA_CLIENT_SECRET=replace-with-alpaca-connect-client-secret
ALPACA_OAUTH_REDIRECT_URI=http://localhost:3000/api/alpaca/oauth/callback
ALPACA_DEFAULT_ENV=paper
# Generate 32 random bytes as base64. Example command:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ALPACA_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
ALPACA_OAUTH_STATE_SECRET=replace-with-random-state-secret

# Sentiment sources used by quant-engine FinBERT job.
SENTIMENT_NEWS_SOURCES=finnhub,marketaux,alpaca,yahoo,newsapi,sec,presswire,macro
NEWS_SENTIMENT_MAX_SYMBOLS=20
MARKETAUX_SENTIMENT_BATCH_SIZE=20
MARKETAUX_SENTIMENT_PAGE_LIMIT=1
MARKETAUX_ARTICLES_PER_REQUEST=20
SENTIMENT_SCAN_MAX_SYMBOLS=30
SENTIMENT_MAX_HEADLINES=25
SENTIMENT_LOOKBACK_DAYS=14
SENTIMENT_SOURCE_TIMEOUT_SECONDS=6
SENTIMENT_SOURCE_CONCURRENCY=6
SENTIMENT_INCLUDE_MACRO_NEWS=false
SENTIMENT_USER_AGENT=TradeMindQuantEngine/1.0
# Required to activate SEC EDGAR. Use a real contact email.
SEC_USER_AGENT=TradeMindQuantEngine/1.0 your-email@example.com
SENTIMENT_EXTRA_RSS_FEEDS=

# ================================
# QUANT ENGINE - NEXT -> FASTAPI
# ================================
QUANT_ENGINE_URL=http://127.0.0.1:8000
QUANT_ENGINE_SECRET=replace-with-quant-engine-secret
QUANT_ENGINE_CACHE_TTL_SECONDS=300
QUANT_ENGINE_AUTH_DISABLED=false

# ================================
# QUANTCONNECT / LEAN
# ================================
QC_USER_ID=replace-with-quantconnect-user-id
QC_API_TOKEN=replace-with-quantconnect-api-token

# ================================
# SCRIPTS DE UTILIDAD
# ================================
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=replace-with-local-test-password

